# Copy to .env for development. `pnpm db:up` starts this Postgres in Docker.
DATABASE_URL=postgres://price_tracker:price_tracker@127.0.0.1:55432/price_tracker
PORT=4380
# Set to false to run the API without scheduled checks (e.g. while working on the UI)
CHECKS_ENABLED=true
# Optional: creates a Gotify notification channel on first start
# GOTIFY_URL=http://127.0.0.1:8082
# GOTIFY_TOKEN=
# Encrypts saved store sign-ins. Generate with: openssl rand -base64 32
# Changing it makes saved sign-ins unreadable (sign in again).
SESSION_KEY=
