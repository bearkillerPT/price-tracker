{
  "name": "@price-tracker/api",
  "private": true,
  "type": "module",
  "bin": {
    "price-tracker": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/main.js",
    "cli": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@price-tracker/shared": "workspace:*",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "playwright-core": "1.59.1",
    "tough-cookie": "^6.1.0",
    "ws": "8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
